---
extends: default
rules:
  line-length:
    max: 160
  document-start: disable
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  indentation:
    indent-sequences: consistent
  braces:
    max-spaces-inside: 1
ignore: |
  .github/
